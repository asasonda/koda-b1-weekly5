
@model Ewallet.Api.ViewModels.DetailViewModel

@{
    ViewData["Title"] = "Wallet Detail";

    var pendapatan = Model.Transactions
        .Where(p => p.ReceiverWalletId == Model.Wallet.Id)
        .Sum(p => p.Amount);

    var pengeluaran = Model.Transactions
        .Where(p => p.SenderWalletId == Model.Wallet.Id)
        .Sum(p => p.Amount);
}

<div class="mx-auto max-w-7xl px-4 py-8 md:px-10">

    <div class="mb-8">
        <a asp-controller="Home"
           asp-action="Detail"
           asp-route-id="@Model.User.Id"
           class="text-sm font-semibold text-gray-500 hover:text-black">
            &larr; Kembali ke Account
        </a>

        <div class="flex flex-col justify-between gap-5 md:flex-row md:items-center">
            <div>
                <h1 class="mt-5 text-2xl font-bold text-gray-900">
                    Detail Wallet
                </h1>
                <p class="mt-1 text-sm text-gray-500">
                    Informasi lengkap wallet pengguna.
                </p>
            </div>

            <div class="flex flex-wrap gap-3">
                <a asp-controller="WalletPage"
                   asp-action="TopUp"
                   asp-route-id="@Model.User.Id"
                   class="rounded-lg bg-black px-5 py-2.5 text-sm font-semibold text-white">
                    + Top Up
                </a>

                <a asp-controller="WalletPage"
                   asp-action="Transfer"
                   asp-route-id="@Model.User.Id"
                   class="rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-700">
                    Transfer
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="mb-5 rounded-lg border border-green-200 bg-green-50 p-4 text-sm text-green-700">
            @success
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="mb-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
            @error
        </div>
    }

    <div class="rounded-xl border border-gray-200 bg-white p-6 md:p-8">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-start">
            <div>
                <p class="text-sm text-gray-500">Wallet Number</p>
                <h2 class="mt-2 text-2xl font-bold text-gray-900">
                    @Model.Wallet.WalletNumber
                </h2>
            </div>

            <div class="md:text-right">
                <p class="text-sm text-gray-500">Current Balance</p>
                <h2 class="mt-2 text-3xl font-bold text-green-600">
                    Rp @Model.Wallet.Balance.ToString("N0")
                </h2>
            </div>
        </div>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="rounded-xl border border-gray-200 bg-white p-6">
            <p class="text-sm text-gray-500">Total Pendapatan</p>
            <h2 class="mt-3 text-2xl font-bold text-green-600">
                + Rp @pendapatan.ToString("N0")
            </h2>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white p-6">
            <p class="text-sm text-gray-500">Total Pengeluaran</p>
            <h2 class="mt-3 text-2xl font-bold text-red-500">
                - Rp @pengeluaran.ToString("N0")
            </h2>
        </div>
    </div>
</div>
