
@model Ewallet.Api.ViewModels.TransferViewModel

@{
    ViewData["Title"] = "Transfer";
    var userId = ViewContext.RouteData.Values["id"];
}

<div class="mx-auto max-w-3xl px-4 py-8 md:px-10">

    <div class="mb-8">
        <a asp-controller="WalletPage"
           asp-action="Detail"
           asp-route-id="@userId"
           class="text-sm font-semibold text-gray-500 hover:text-black">
            &larr; Kembali ke Wallet
        </a>

        <h1 class="mt-5 text-2xl font-bold text-gray-900">
            Transfer Saldo
        </h1>

        <p class="mt-1 text-sm text-gray-500">
            Kirim saldo ke wallet pengguna lain.
        </p>
    </div>

    <div class="max-w-2xl rounded-xl border border-gray-200 bg-white p-6 md:p-8">

        <h2 class="text-lg font-bold text-gray-900">
            Informasi Transfer
        </h2>

        <form method="post"
              asp-controller="WalletPage"
              asp-action="Transfer"
              asp-route-id="@userId"
              class="mt-7 space-y-6">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-red-500">
            </div>

            <div>
                <label asp-for="ReceiverWalletId"
                       class="mb-2 block text-sm font-semibold text-gray-700">
                    Pilih Wallet Tujuan
                </label>

                <select asp-for="ReceiverWalletId"
                        asp-items="Model.WalletOptions"
                        class="w-full rounded-lg border border-gray-300 px-4 py-3 text-sm outline-none focus:border-black">
                    <option value="">-- Pilih wallet tujuan --</option>
                </select>

                <span asp-validation-for="ReceiverWalletId"
                      class="mt-1 block text-sm text-red-500">
                </span>
            </div>

            <div>
                <label asp-for="Amount"
                       class="mb-2 block text-sm font-semibold text-gray-700">
                    Nominal Transfer
                </label>

                <div class="flex overflow-hidden rounded-lg border border-gray-300">
                    <span class="flex items-center bg-gray-50 px-4 text-sm font-semibold text-gray-600">
                        Rp
                    </span>

                    <input asp-for="Amount"
                           type="number"
                           min="1"
                           step="0.01"
                           placeholder="Masukkan nominal"
                           class="w-full px-4 py-3 text-sm outline-none" />
                </div>

                <span asp-validation-for="Amount"
                      class="mt-1 block text-sm text-red-500">
                </span>
            </div>

            <div>
                <label asp-for="Description"
                       class="mb-2 block text-sm font-semibold text-gray-700">
                    Deskripsi (Opsional)
                </label>

                <textarea asp-for="Description"
                          rows="3"
                          placeholder="Contoh: Pembayaran makan"
                          class="w-full resize-none rounded-lg border border-gray-300 px-4 py-3 text-sm outline-none focus:border-black"></textarea>

                <span asp-validation-for="Description"
                      class="mt-1 block text-sm text-red-500">
                </span>
            </div>

            <div class="flex flex-col gap-3 border-t border-gray-100 pt-6 sm:flex-row">

                <a asp-controller="WalletPage"
                   asp-action="Detail"
                   asp-route-id="@userId"
                   class="flex-1 rounded-lg border border-gray-300 px-5 py-3 text-center text-sm font-semibold text-gray-700">
                    Batal
                </a>

                <button type="submit"
                        class="flex-1 rounded-lg bg-black px-5 py-3 text-sm font-semibold text-white hover:bg-gray-800">
                    Kirim Transfer
                </button>

            </div>

        </form>
    </div>
</div>
