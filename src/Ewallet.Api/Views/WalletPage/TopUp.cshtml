@model Ewallet.Api.ViewModels.TopUpViewModel

@{
    ViewData["Title"] = "Top Up";
    var userId = ViewContext.RouteData.Values["id"];
}

<div class="mx-auto max-w-3xl px-4 py-8 md:px-10">

    <h1 class="mb-2 text-2xl font-bold text-gray-900">
        Top Up Wallet
    </h1>

    <p class="mb-8 text-sm text-gray-500">
        Tambahkan saldo ke wallet kamu.
    </p>

    <div class="rounded-xl border border-gray-200 bg-white p-6">

        <form asp-action="TopUp"
              asp-route-id="@userId"
              method="post"
              class="space-y-5">

            <div asp-validation-summary="All"
                 class="text-sm text-red-500">
            </div>

            <div>
                <label asp-for="Amount"
                       class="mb-2 block text-sm font-semibold text-gray-700">
                    Nominal Top Up
                </label>

                <input asp-for="Amount"
                       type="number"
                       min="0.01"
                       step="0.01"
                       placeholder="Masukkan nominal"
                       class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-black" />

                <span asp-validation-for="Amount"
                      class="text-sm text-red-500"></span>
            </div>

            <div class="flex justify-end gap-3 border-t border-gray-100 pt-5">

                <a asp-action="Detail"
                   asp-route-id="@userId"
                   class="rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-700">
                    Batal
                </a>

                <button type="submit"
                        class="rounded-lg bg-black px-5 py-2.5 text-sm font-semibold text-white">
                    Top Up Sekarang
                </button>

            </div>

        </form>
    </div>
</div>