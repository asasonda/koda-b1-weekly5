                Semua transaksi yang dilakukan pada wallet ini.
            </p>
        </div>


        @if (Model.Transactions.Count == 0)
        {
            <div class="rounded-lg border border-dashed border-gray-300 p-10 text-center">
                <p class="font-semibold text-gray-700">
