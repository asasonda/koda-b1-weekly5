@model Ewallet.Api.ViewModels.DetailViewModel

@{
    ViewData["Title"] = "Detail";
    
}
<div class="mx-auto max-w-7xl px-4 py-8 md:px-10">
    <a asp-controller="Home"
        asp-action="Index"
        class="text-sm font-semibold text-gray-500 hover:text-black">&larr; Kembali ke Home
    </a>
    <div class="rounded-lg border border-gray-200 bg-white p-6 mt-3">
        <div class="flex flex-col justify-between gap-5 md:flex-row md:items-start">
            <div>
                <p class="text-sm text-gray-500">Informasi Account</p>
                <h2 class="mt-1 text-2xl font-bold text-gray-900">
                    @Model.User.Name
                </h2>
                <p class="mt-1 text-sm text-gray-500">@Model.User.Email</p>
                <p class="mt-1 text-sm text-gray-500">@Model.User.Phone</p>
            </div>

            <div class="md:text-right">
                <p class="text-sm text-gray-500">Nomor Wallet</p>
                <p class="mt-1 font-semibold text-gray-900">
                    @Model.Wallet.WalletNumber
                </p>
                <p class="mt-4 text-sm text-gray-500">Saldo Wallet</p>
                <p class="text-2xl font-bold text-gray-900">
                    Rp @Model.Wallet.Balance.ToString("N0")
                </p>
            </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-3 border-t border-gray-100 pt-5">
            <a asp-controller="Home"
                asp-action="Edit"
                asp-route-id="@Model.User.Id"
                class="rounded-lg bg-black px-5 py-2.5 text-sm font-semibold text-white">
                    Update Data
            </a>

            <a asp-controller="WalletPage"
                asp-action="Detail"
                asp-route-id="@Model.User.Id"
                class="rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-700">
                    Detail Wallet
            </a>

            <a asp-controller="Home"
                asp-action="History"
                asp-route-id="@Model.User.Id"
                class="rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-700">
                    Riwayat Transaksi
            </a>
        </div>
    </div>

    @* <div class="mt-10">
        <div class="mb-3">
            <h2 class="text-xl font-bold text-gray-900">
                Riwayat Transaksi
            </h2>
