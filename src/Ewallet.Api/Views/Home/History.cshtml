
@model Ewallet.Api.ViewModels.DetailViewModel

@{
    ViewData["Title"] = "Riwayat Transaksi";

    var totalPemasukan = Model.Transactions
        .Where(t => t.ReceiverWalletId == Model.Wallet.Id)
        .Sum(t => t.Amount);

    var totalPengeluaran = Model.Transactions
        .Where(t => t.SenderWalletId == Model.Wallet.Id)
        .Sum(t => t.Amount);
}

<div class="mx-auto max-w-7xl px-4 py-8 md:px-10">

    <!-- Header -->
    <div class="mb-8">
        <a asp-controller="Home"
           asp-action="Detail"
           asp-route-id="@Model.User.Id"
           class="text-sm font-semibold text-gray-500 hover:text-black">
            &larr; Kembali ke Detail User
        </a>

        <h1 class="mt-5 text-2xl font-bold text-gray-900">
            Riwayat Transaksi
        </h1>

        <p class="mt-1 text-sm text-gray-500">
            Seluruh aktivitas transaksi wallet @Model.User.Name.
        </p>
    </div>

    <div class="">
        @if (Model.Transactions.Count == 0)
        {
            <div class="rounded-lg border border-dashed border-gray-300 p-10 text-center">
                <p class="font-semibold text-gray-700">
                    Belum ada transaksi.
                </p>

                <p class="mt-1 text-sm text-gray-500">
                    Riwayat transaksi akan muncul di sini.
                </p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto rounded-lg border border-gray-200">
                <table class="w-full text-left text-sm">
                    <thead class="bg-black text-white">
                        <tr>
                            <th class="px-5 py-4">Transaction</th>
                            <th class="px-5 py-4">Description</th>
                            <th class="px-5 py-4">Amount</th>
                            <th class="px-5 py-4">Date</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var transaction in Model.Transactions
                            .OrderByDescending(t => t.CreatedAt))
                        {
                            var isPendapatan =
                                transaction.ReceiverWalletId == Model.Wallet.Id;

                            <tr>
                                <td class="border-b border-gray-200 px-5 py-4">
                                    <span class="font-semibold @(isPendapatan ? "text-green-600" : "text-red-600")">
                                        @(isPendapatan ? "Pendapatan" : "Pengeluaran")
                                    </span>

                                    <p class="mt-1 text-xs text-gray-400">
                                        @transaction.Type
                                    </p>
                                </td>

                                <td class="border-b border-gray-200 px-5 py-4 text-gray-600">
                                    @(transaction.Description ?? "-")
                                </td>

                                <td class="border-b border-gray-200 px-5 py-4 font-semibold @(isPendapatan ? "text-green-600" : "text-red-600")">
                                    @(isPendapatan ? "+" : "-") Rp @transaction.Amount.ToString("N0")
                                </td>

                                <td class="whitespace-nowrap border-b border-gray-200 px-5 py-4 text-gray-500">
                                    @transaction.CreatedAt.ToString("dd MMM yyyy HH:mm")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>
