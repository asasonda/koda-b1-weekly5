@model Ewallet.Api.DTOs.UserRequest

@{
    ViewData["Title"] = "Tambah User";
}

<div class="mx-auto max-w-3xl px-4 py-8 md:px-10">

    <div class="mb-8">
        <a asp-controller="Home"
           asp-action="Index"
           class="text-sm font-semibold text-gray-500 hover:text-black">
            &larr; Kembali
        </a>

        <h1 class="mt-5 text-2xl font-bold text-gray-900">
            Tambah Pengguna
        </h1>

        <p class="mt-1 text-sm text-gray-500">
            Daftarkan pengguna sekaligus membuat wallet baru.
        </p>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-6 md:p-8">
        <form asp-controller="Home"
              asp-action="Create"
              method="post"
              class="space-y-5">

            <div>
                <label asp-for="Name"
                       class="mb-2 block text-sm font-semibold text-gray-700">
                    Nama Lengkap
                </label>

                <input asp-for="Name"
                       class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-black" />

                <span asp-validation-for="Name"
                      class="text-sm text-red-500"></span>
            </div>

            <div>
                <label asp-for="Email"
                       class="mb-2 block text-sm font-semibold text-gray-700">
                    Email
                </label>

                <input asp-for="Email"
                       type="email"
                       class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-black" />

                <span asp-validation-for="Email"
                      class="text-sm text-red-500"></span>
            </div>

            <div>
                <label asp-for="Phone" class="mb-2 block text-sm font-semibold text-gray-700">
                    Nomor Telepon
                </label>

                <input asp-for="Phone" class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-black" />
                <span asp-validation-for="Phone" class="text-sm text-red-500"></span>
            </div>

            <div>
                <label asp-for="WalletNumber"
                       class="mb-2 block text-sm font-semibold text-gray-700">
                    Nomor Wallet
                </label>

                <input asp-for="WalletNumber"
                       class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-black" />

                <span asp-validation-for="WalletNumber"
                      class="text-sm text-red-500"></span>
            </div>

            <div class="flex justify-end gap-3 border-t border-gray-100 pt-5">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-700">
                    Batal
                </a>

                <button type="submit"
                        class="rounded-lg bg-black px-5 py-2.5 text-sm font-semibold text-white">
                    Simpan User
                </button>
            </div>
        </form>
    </div>
</div>